# ============================================
# SauceLabs My Demo App - Appium Test 환경 변수
# ============================================
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
#   cp .env.example .env
#   (PowerShell: Copy-Item .env.example .env)
#
# 모든 변수는 선택사항입니다. 미설정 시 기본값이 사용됩니다.

# ============================================
# Appium 서버 설정
# ============================================
# Appium 서버 호스트 (기본: 127.0.0.1)
# APPIUM_HOST=127.0.0.1

# Appium 서버 포트 (기본: 4723)
# APPIUM_PORT=4723

# ============================================
# Android 디바이스 설정
# ============================================
# 실물 디바이스 시리얼 (adb devices 명령으로 확인)
# 에뮬레이터 사용 시 주석 처리
# ANDROID_UDID=XXXXXXXX

# 디바이스 이름 (Allure 리포트 표시용, 기본: Android Emulator)
# ANDROID_DEVICE_NAME=Pixel 6 API 34

# Android OS 버전 (기본: 자동 감지)
# ANDROID_PLATFORM_VERSION=14

# Android SDK 경로 — aapt로 APK 메타(앱 이름/버전) 추출에 필요.
# 보통 시스템 환경변수(~/.zshrc 등)에 이미 설정되어 있으므로 여기서는 보통 비워둡니다.
# 미설정 시 Allure 리포트에서 appName/appVersion이 비어 보일 수 있습니다.
# ANDROID_HOME=/Users/{사용자명}/Library/Android/sdk

# ============================================
# iOS 시뮬레이터 설정 (macOS에서만 사용)
# ============================================
# iOS 시뮬레이터 이름 (기본: iPhone 15)
# IOS_DEVICE_NAME=iPhone 15

# iOS 버전 (기본: 17.0)
# IOS_PLATFORM_VERSION=17.0

# iOS 시뮬레이터 UUID — 다중 시뮬레이터 부팅 시 특정 시뮬을 지정.
# 미설정이면 IOS_DEVICE_NAME + IOS_PLATFORM_VERSION으로 매칭 (xcrun simctl list 로 UUID 확인)
# IOS_UDID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ============================================
# Allure 리포트 (선택사항)
# ============================================
# 리포트 실행자 표시명 (미설정 시 "local" — OS 사용자명은 기록하지 않음)
# EXECUTOR_NAME=ci
